{
	"name": "n8n-nodes-firecrawl-v2",
	"version": "2.0.0",
	"description": "n8n community node for Firecrawl v2 API (Cloud + self-hosted) - scrape, crawl, map, search, extract, and batch operations",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"firecrawl",
		"web-scraping",
		"crawling",
		"data-extraction",
		"ai-agent",
		"search"
	],
	"license": "MIT",
	"homepage": "https://hecigo.com/blog/n8n-firecrawl-node-choosing-the-right-operation/",
	"author": {
		"name": "hecigo",
		"email": "hi@hecigo.com",
		"url": "https://hecigo.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/hecigo/n8n-nodes-firecrawl-v2.git"
	},
	"main": "index.js",
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc && gulp build:assets",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint package.json nodes credentials",
		"lintfix": "eslint package.json nodes credentials --fix",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/FirecrawlApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Firecrawl/Firecrawl.node.js"
		]
	},
	"devDependencies": {
		"@n8n/eslint-plugin-community-nodes": "^0.29.0",
		"@types/node": "^25.5.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^9.0.0",
		"eslint-plugin-n8n-nodes-base": "^2.0.0",
		"gulp": "^4.0.2",
		"n8n-workflow": "^2.0.0",
		"prettier": "^3.2.0",
		"rimraf": "^5.0.0",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
